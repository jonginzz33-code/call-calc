rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/config/admin)
        && get(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid;
    }
    function notBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true;
    }

    match /config/admin {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['banned', 'features']);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned', 'features']));
      allow delete: if isAdmin();

      match /calls/{id} {
        allow read, delete: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update: if signedIn() && request.auth.uid == uid && notBanned();
      }
    }

    match /teams/{code} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      allow read: if isMember() || isAdmin();
      allow create: if signedIn() && notBanned()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if isMember() || isAdmin() || (signedIn() && notBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
        && request.resource.data.members.removeAll(resource.data.members) == [request.auth.uid]
        && resource.data.members.size() < 4);
      allow delete: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);

      match /shares/{id} {
        function member() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/teams/$(code)).data.members;
        }
        allow read, delete: if member() || isAdmin();
        allow create: if member() && notBanned() && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
