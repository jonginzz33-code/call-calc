rules_version = '2';
// 계산기 서버 규칙 (Firebase 콘솔 → Firestore Database → 규칙 에 붙여 넣고 [게시])
service cloud.firestore {
  match /databases/{database}/documents {

    // 내 콜 기록: 나만 읽고 쓰기
    match /users/{uid}/calls/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 팀 (2인 1조)
    match /teams/{code} {
      function signedIn() { return request.auth != null; }
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }

      allow read: if isMember();
      // 만들기: 나 혼자 들어 있는 팀
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // 들어가기(코드 넣기): 나만 추가, 다른 칸은 그대로 / 팀원은 바꾸기·나가기 가능
      allow update: if isMember() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
        && request.resource.data.members.removeAll(resource.data.members) == [request.auth.uid]
        && resource.data.members.size() < 4);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // 수락한 콜 알림: 팀원만
      match /shares/{id} {
        function member() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/teams/$(code)).data.members;
        }
        allow read, delete: if member();
        allow create: if member() && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
